rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isManager() {
      return isAuthenticated() && 
        (request.auth.token.role == 'manager' || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isManager();
    }

    // Maintenance Collections and Invoices
    match /maintenance/{invoiceId} {
      allow read: if isAuthenticated() && (isManager() || resource.data.tenantId == request.auth.uid);
      allow create, update, delete: if isManager();
      // Allow tenant to mark their own invoice paid via simulated payment
      allow update: if isAuthenticated() && resource.data.tenantId == request.auth.uid && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'paymentMethod', 'transactionId']);
    }

    // Reminders
    match /reminders/{reminderId} {
      allow read: if isAuthenticated() && (isManager() || resource.data.targetUnit == request.auth.token.unitNumber || resource.data.tenantId == request.auth.uid);
      allow create, delete: if isManager();
      allow update: if isAuthenticated() && (isManager() || resource.data.tenantId == request.auth.uid);
    }

    // Service Requests (Electric, Plumbing, etc.)
    match /serviceRequests/{requestId} {
      allow read: if isAuthenticated() && (isManager() || resource.data.tenantId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isManager() || (resource.data.tenantId == request.auth.uid && resource.data.status == 'Pending');
    }

    // Community Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Association Rules and Bylaws
    match /associationRules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Meeting Minutes
    match /meetingMinutes/{minuteId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Expense Account Statements
    match /expenseStatements/{statementId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }
  }
}
